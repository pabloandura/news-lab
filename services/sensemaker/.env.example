PORT=3000
GCP_PROJECT_ID=news-lab-2ba2d
GCP_REGION=us-central1

# NewsAPI key (same one used by the Flutter app)
NEWS_API_KEY=

# Path to Firebase service account JSON (local dev only).
# On Cloud Run, omit this — ADC is used automatically via the attached service account.
GOOGLE_APPLICATION_CREDENTIALS=../../credentials/service-account.json

# Ollama config (local dev only — ignored in production)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text

# Optional ingestion tuning
MAX_ARTICLES_PER_SOURCE=50
SNIPPET_LENGTH=300
