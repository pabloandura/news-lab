rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /articles/{articleId} {
      // Anyone (including unauthenticated users) can read articles
      allow read: if true;

      // Only authenticated users can create an article
      // The authorId in the document must match the caller's UID
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.content is string
                    && request.resource.data.content.size() > 0
                    && request.resource.data.thumbnailUrl is string
                    && request.resource.data.thumbnailUrl.matches('https://.*');

      // Only the original author can update or delete their own article
      allow update, delete: if request.auth != null
                             && resource.data.authorId == request.auth.uid;
    }

  }
}
