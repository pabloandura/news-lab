rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    match /media/articles/{fileName} {
      // Anyone can read article thumbnails
      allow read: if true;

      // Only authenticated users can upload thumbnails
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024   // max 10 MB
                   && request.resource.contentType.matches('image/.*');
    }

  }
}
