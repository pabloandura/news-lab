rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /articles/{articleId} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.content is string
                    && request.resource.data.content.size() > 0
                    && request.resource.data.thumbnailUrl is string
                    && request.resource.data.thumbnailUrl.matches('https://.*');

      allow update, delete: if request.auth != null
                             && resource.data.authorId == request.auth.uid;
    }

    // Categories are read-only for all users; only admins write via console
    match /articleCategories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    // Fact checks: anyone can read, only authenticated users can update counters or vote
    match /fact_checks/{articleId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /votes/{userId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Bias reports: public read, authenticated write (polarizer service uses admin SDK)
    match /bias_reports/{articleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Article view counters: public read, authenticated increment-only write; authorId immutable
    match /article_views/{articleId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null
                    && request.resource.data.viewCount == resource.data.viewCount + 1
                    && request.resource.data.authorId == resource.data.authorId;

      match /daily_views/{day} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // Author daily view aggregates: public read, authenticated write
    match /author_daily_views/{authorId} {
      allow read: if true;

      match /days/{day} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // Materialized stats (bias_landscape etc.): public read, write only via admin SDK
    match /stats/{statId} {
      allow read: if true;
      allow write: if false;
    }

  }
}
