rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /articles/{articleId} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.content is string
                    && request.resource.data.content.size() > 0
                    && request.resource.data.thumbnailUrl is string
                    && request.resource.data.thumbnailUrl.matches('https://.*');

      allow update, delete: if request.auth != null
                             && resource.data.authorId == request.auth.uid;
    }

    // Categories are read-only for all users; only admins write via console
    match /articleCategories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    // Fact checks: anyone can read, only authenticated users can update counters or vote
    match /fact_checks/{articleId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /votes/{userId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

  }
}
